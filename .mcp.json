{
  "mcpServers": {
    "engram": {
      "command": "engram",
      "args": ["mcp", "--project", "Agente"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "graphify": {
      "command": "graphify-mcp",
      "args": ["graphify-out/graph.json"]
    }
  }
}
