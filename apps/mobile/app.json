{
  "expo": {
    "name": "Agente",
    "slug": "agente",
    "scheme": "agente",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/92c01f68-bf32-494e-8a73-0b5489620845"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agente.app"
    },
    "android": {
      "package": "com.agente.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7F9",
          "dark": { "backgroundColor": "#12151A" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "92c01f68-bf32-494e-8a73-0b5489620845"
      }
    }
  }
}
