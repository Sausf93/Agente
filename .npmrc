# Instalación "hoisted" (node_modules plano en la raíz del workspace), en lugar del
# árbol aislado por defecto de pnpm. Es la recomendación oficial de Expo/React Native
# para monorepos con pnpm: Metro no resuelve bien el árbol simbólico aislado, y las
# dependencias transitivas de la runtime de Expo (@expo/metro-runtime, whatwg-fetch…)
# quedaban sin hoistear y rompían `expo export`. Ver docs/DECISIONES.md · ADR-013.
node-linker=hoisted
